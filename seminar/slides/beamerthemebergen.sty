%-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
%	TITLE PAGE
%-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
\def\maketitle{\ifbeamer@inframe\titlepage\else\frame[plain]{\titlepage}\fi}

\setbeamerfont{title}{series=\rmfamily,size={\fontsize{14}{0}}}
\setbeamerfont{institute}{series=\rmfamily, size={\fontsize{8}{8}}}
\setbeamerfont{date}{series=\rmfamily, size={\fontsize{7}{0}}}

\def\titlepage{\usebeamertemplate{title page}}
\setbeamertemplate{title page}
{
	\begin{minipage}[b][\paperheight]{\textwidth}
		%Logo:
		% \tikz [remember picture,overlay]
		%     \node at
		%         (current page.south east)
		%         [anchor = south east, yshift=1em, xshift=-12ex]{%
		%           \includegraphics[height=7em]{hvl-logo-en}
		%         };
		\tikz [remember picture,overlay]
		\node at
		(current page.south east)
		[anchor = south east, yshift=2em, xshift=-5ex]{%
			\includegraphics[height=5em]{UiB_logo}
		};
		\vfill
		\ifx\inserttitle\@empty%
			\else%
			{\raggedright\linespread{1.0} \usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
			\vspace*{0.5em}
		\fi%

		\ifx\insertsubtitle\@empty%
			\else%
			{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
			\vspace*{0.5em}
		\fi%

		\begin{tikzpicture}\draw[normal text.fg] (0, 0) -- (\textwidth, 0);\end{tikzpicture}%
		\vspace*{1em}
		\ifx\insertauthor\@empty%
			\else%
			{\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor \par}%
			\vspace*{1mm}
		\fi%

		\ifx\insertinstitut\@empty%
			\else%
			%\vspace*{1mm}
			{\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}%
			\vspace*{1mm}
		\fi%

		\ifx\insertdate\@empty%
		\else%
			\vspace*{5mm}
			{\usebeamerfont{date}\color{black}\insertdate \par
			}%
		\fi%
		\hfill \usebeamercolor[fg]{titlegraphic}\inserttitlegraphic \par
		\vspace*{15mm}
		\vfill
	\end{minipage}
}

