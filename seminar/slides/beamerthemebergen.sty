%	IMAGES
%-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
\newbox\mytempbox
\newdimen\mytempdimen

\newcommand\includegraphicscopyright[3][]{%
	\leavevmode\vbox{\vskip3pt\raggedright\setbox\mytempbox=\hbox{\includegraphics[#1]{#2}}%
		\mytempdimen=\wd\mytempbox\box\mytempbox\par\vskip1pt%
		\usebeamerfont{copyright text}{\usebeamercolor[fg]{copyright text}{\vbox{\hsize=\mytempdimen#3}}}\vskip3pt%
	}}

%-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
%	BLOCKS
%-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
\newlength{\bergen@blocksep}
\newlength{\bergen@blockadjust}
\setlength{\bergen@blocksep}{0.75ex}
\setlength{\bergen@blockadjust}{0.25ex}
\providecommand{\bergen@strut}{%
	\vphantom{ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz()}%
}
\newcommand{\bergen@block}[1]{
\par\vskip\medskipamount%
\setlength{\parskip}{2pt}
\ifbeamercolorempty[bg]{block title#1}{%
\begin{beamercolorbox}[rightskip=0pt plus 4em]{block title#1}}{%
\ifbeamercolorempty[bg]{block title}{%
	\begin{beamercolorbox}[rightskip=0pt plus 4em]{block title#1}%
		}%
		{%
		\begin{beamercolorbox}[
				sep=\dimexpr\bergen@blocksep-\bergen@blockadjust\relax,
				leftskip=\bergen@blockadjust,
				rightskip=\dimexpr\bergen@blockadjust plus 4em\relax
			]{block title#1}%
			}}%
			\usebeamerfont*{block title#1}%
			\bergen@strut%
			\insertblocktitle%
			\bergen@strut%
		\end{beamercolorbox}%
		\nointerlineskip%
		\ifbeamercolorempty[bg]{block body#1}{%
			\begin{beamercolorbox}[vmode]{block body#1}}{
				\ifbeamercolorempty[bg]{block body}{%
					\begin{beamercolorbox}[vmode]{block body#1}%
						}{%
						\begin{beamercolorbox}[sep=\bergen@blocksep, vmode]{block body#1}%
							\vspace{-\bergen@parskip}
							}}%
							\usebeamerfont{block body#1}%
							\setlength{\parskip}{\bergen@parskip}%
							}
							\setbeamertemplate{block begin}{\bergen@block{}}
							\setbeamertemplate{block alerted begin}{\bergen@block{ alerted}}
							\setbeamertemplate{block example begin}{\bergen@block{ example}}
							\setbeamertemplate{block magenta begin}{\bergen@block{ magenta}}
							\setbeamertemplate{block end}{\end{beamercolorbox}\vspace*{0.2ex}}
						\setbeamertemplate{block alerted end}{\end{beamercolorbox}\vspace*{0.2ex}}
				\setbeamertemplate{block example end}{\end{beamercolorbox}\vspace*{0.2ex}}
		\setbeamertemplate{block magenta end}{\end{beamercolorbox}\vspace*{0.2ex}}

\newlength{\bergen@parskip}
\setlength{\bergen@parskip}{0.5em}
\setlength{\parskip}{\bergen@parskip}
\mode
<all>

\let\otp\titlepage
\renewcommand{\titlepage}{\otp\addtocounter{framenumber}{-1}}
