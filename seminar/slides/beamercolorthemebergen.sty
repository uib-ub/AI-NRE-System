% General
\setbeamercolor{normal text}{fg=bergenDarkGrey} \setbeamercolor{structure}{fg=bergenDarkGrey} \setbeamercolor{alerted text}{fg=bergenRed} \setbeamercolor{example text}{fg=bergenGreen} \setbeamercolor{magenta text}{fg=bergenMagenta} \setbeamercolor{copyright text}{fg=bergenPurple}

% Palettes
\setbeamercolor{palette primary}{fg=bergenGrey, bg=bergenDarkGrey} \setbeamercolor{palette secondary}{fg=bergenDarkGrey,bg=bergenGrey} \setbeamercolor{palette tertiary}{fg=bergenLightBlue, bg=bergenDarkGrey} \setbeamercolor{palette quaternary}{fg=bergenGrey, bg=bergenBlue} \setbeamercolor{mini frame}{bg=bergenGrey} \setbeamercolor{section in head/foot}{fg=bergenDarkGrey, bg=bergenGrey}

% Titlepage
\setbeamercolor{title}{parent=normal text} \setbeamercolor{subtitle}{fg=bergenBlue} \setbeamercolor{institute}{parent=normal text}

% Content
\setbeamercolor{frametitle}{parent=palette primary}

% Blocks
\setbeamercolor{block title}{fg=white,bg=bergenBlue} \setbeamercolor{block body}{fg=bergenDarkGrey, bg=bergenGrey} \setbeamercolor{block title example}{fg=white, bg=bergenGreen} \setbeamercolor{block body example}{fg=bergenDarkGrey, bg=bergenGrey} \setbeamercolor{block title alerted}{fg=white, bg=bergenRed} \setbeamercolor{block body alerted}{fg=bergenDarkGrey, bg=bergenGrey} \setbeamercolor{block title magenta}{fg=white, bg=bergenMagenta} \setbeamercolor{block body magenta}{fg=bergenDarkGrey, bg=bergenGrey}

% Notes
\setbeamercolor{note page}{fg=bergenDarkGrey,bg=bergenGrey} \setbeamercolor{note title}{fg=white, bg=bergenDarkGrey} \setbeamercolor{note date}{parent=note title}

% Page Number
\setbeamercolor{page number in head/foot}{fg=bergenDarkGrey} \setbeamercolor{qed}{fg=bergenGreen} \setbeamercolor{itemize item}{fg=bergenBlue} \setbeamercolor{itemize subitem}{fg=bergenRed} \setbeamercolor{itemize subsubitem}{fg=bergenPurple}

\mode<all>
